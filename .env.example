# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional PostgreSQL connection string (e.g. Neon / Supabase on Vercel)
DATABASE_URL=

# Optional Cloudflare Stream Credentials (Server-side only, never expose with VITE_)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# Optional Payment Gateways (Server-side only, never expose with VITE_)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_PAYMENT_LINK=
MIDTRANS_SERVER_KEY=
QRIS_WEBHOOK_SECRET=
